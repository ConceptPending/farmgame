{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // Plain `tsc` per package (Turbo orders builds via ^build); `composite`
    // + project references were a half-adopted alternative that only emitted
    // .tsbuildinfo for nothing. `incremental` keeps the fast local rebuilds.
    "incremental": true
  }
}
